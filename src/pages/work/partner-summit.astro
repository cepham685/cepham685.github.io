    .outcome-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .pi-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .overview-details {
      grid-template-columns: 1fr 1fr;
    }

    .swatches-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-row,
    .gallery-row.four-col {
      grid-template-columns: 1fr;
    }

    .event-grid {
      grid-template-columns: 1fr;
    }

    .event-wide {
      grid-column: auto;
    }

    .outcome-stats {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = lightbox?.querySelector(".lightbox-img") as HTMLImageElement | null;
  const closeBtn = lightbox?.querySelector(".lightbox-close");
  const prevBtn = lightbox?.querySelector(".lightbox-prev");
  const nextBtn = lightbox?.querySelector(".lightbox-next");
  const counter = lightbox?.querySelector(".lightbox-counter");

  let pages: string[] = [];
  let currentIndex = 0;
  let currentAlt = "";

  const render = () => {
    if (!lightbox || !lightboxImg || pages.length === 0) return;
    lightboxImg.setAttribute("src", pages[currentIndex]);
    lightboxImg.setAttribute("alt", currentAlt);
    if (counter) counter.textContent = `${currentIndex + 1} / ${pages.length}`;
    lightbox.classList.toggle("has-nav", pages.length > 1);
  };

  document.querySelectorAll(".gallery-img, .feature-img, .onsite-photo").forEach((img) => {
    img.addEventListener("click", () => {
      if (!lightbox) return;
      const raw = img.getAttribute("data-pages");
      if (raw) {
        try { pages = JSON.parse(raw); } catch { pages = [img.getAttribute("src") || ""]; }
      } else {
        pages = [img.getAttribute("src") || ""];
      }
      currentAlt = img.getAttribute("alt") || "";
      currentIndex = 0;
      render();
      lightbox.classList.add("open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    });
  });

  const close = () => {
    lightbox?.classList.remove("open");
    lightbox?.classList.remove("has-nav");
    lightbox?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  const next = () => {
    if (pages.length <= 1) return;
    currentIndex = (currentIndex + 1) % pages.length;
    render();
  };

  const prev = () => {
    if (pages.length <= 1) return;
    currentIndex = (currentIndex - 1 + pages.length) % pages.length;
    render();
  };

  lightbox?.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (e.target === lightbox || target.classList.contains("lightbox-close")) close();
  });

  closeBtn?.addEventListener("click", (e) => { e.stopPropagation(); close(); });
  nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); next(); });
  prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); prev(); });

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("open")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowRight") next();
    if (e.key === "ArrowLeft") prev();
  });
</script>
